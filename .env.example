# Copy to .env (gitignored) and fill in. Load into your shell with:
#   set -a; source .env; set +a
# CI sets the same names from GitHub secrets/variables (see README.md).
#
# Least-privilege Cloudflare API tokens; exact dashboard permissions in README.md > "Credentials setup".
# Wrangler, `cf`, cf-terraforming and OpenTofu all read CLOUDFLARE_API_TOKEN, so it defaults
# to the read-only token; override it per command for writes:
#   CLOUDFLARE_API_TOKEN=$CLOUDFLARE_DEPLOY_TOKEN npm run deploy
#   CLOUDFLARE_API_TOKEN=$CLOUDFLARE_TF_APPLY_TOKEN tofu -chdir=infra apply

# --- Cloudflare credentials (secret) ---
# Token <site>-tf-read. Read-only: tofu plan, cf-terraforming, `npx cf` inspection. Same value as the GitHub secret CLOUDFLARE_TF_READ_TOKEN.
CLOUDFLARE_TF_READ_TOKEN=
# Token <site>-deploy. `npm run deploy` (Wrangler). Same value as the GitHub environment secret CLOUDFLARE_DEPLOY_TOKEN.
CLOUDFLARE_DEPLOY_TOKEN=
# Token <site>-tf-apply. Local `tofu apply` only; never stored in GitHub.
CLOUDFLARE_TF_APPLY_TOKEN=
# What every tool actually reads. Keep the read-only default.
CLOUDFLARE_API_TOKEN=${CLOUDFLARE_TF_READ_TOKEN}

# Cloudflare account ID (an identifier, not a secret). Read by Wrangler and `cf`.
CLOUDFLARE_ACCOUNT_ID=

# --- Site identity (passed to Wrangler by `npm run deploy`) ---
# Apex domain the Worker is published to, e.g. example.com.
SITE_DOMAIN=
# Worker name: lowercase letters, digits and dashes, e.g. example-com.
WORKER_NAME=

# --- OpenTofu inputs (read by tofu in infra/) ---
TF_VAR_account_id=${CLOUDFLARE_ACCOUNT_ID}
TF_VAR_zone_name=${SITE_DOMAIN}
# Secret. At least 16 characters; encrypts infra/terraform.tfstate. Keep it in a password manager.
TF_VAR_state_passphrase=
