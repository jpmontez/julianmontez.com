---
import PhotoPage from '../components/PhotoPage.astro';
import { getPosts, postSlug } from '../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({ params: { slug: postSlug(post) }, props: { posts, index } }));
}
---

<PhotoPage {...Astro.props} />
