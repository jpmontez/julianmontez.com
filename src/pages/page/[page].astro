---
import Feed from '../../components/Feed.astro';
import { siteConfig } from '../../config';
import { getPosts } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const totalPages = Math.ceil(posts.length / siteConfig.postsPerPage);

  // Generate pages 2..N (page 1 is index.astro)
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const pageNum = i + 2;
    const start = (pageNum - 1) * siteConfig.postsPerPage;
    return {
      params: { page: String(pageNum) },
      props: { posts: posts.slice(start, start + siteConfig.postsPerPage), pageNum, totalPages },
    };
  });
}

const { posts, pageNum, totalPages } = Astro.props;
---

<Feed posts={posts} pageNum={pageNum} totalPages={totalPages} />
