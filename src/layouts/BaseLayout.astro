---
import '../styles/theme.css';
import { siteConfig } from '../config';

interface Props {
  pageTitle: string;
  pageDescription?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImageUrl?: string;
  preloadSrcset?: string;
  preloadSizes?: string;
  // Marks the matching header link with aria-current="page"
  current?: 'index';
  // Template class on the page wrapper: "photo-page" or "index-page"
  pageClass?: string;
  // Centre header slot that names the photo's top-third click zone while it's hovered or focused
  sheetLabel?: boolean;
}

const {
  pageTitle,
  pageDescription = siteConfig.description,
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  ogImageUrl,
  preloadSrcset,
  preloadSizes,
  current,
  pageClass,
  sheetLabel,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const TitleTag = isHome ? 'h1' : 'span';

// Cloudflare Email Obfuscation doesn't apply to Worker responses, so the address ships
// XOR-encoded and the inline script below turns it into a mailto: link in the browser.
const emailKey = 0x5a;
const encodedEmail = Array.from(siteConfig.email, (c) =>
  (c.charCodeAt(0) ^ emailKey).toString(16).padStart(2, '0')
).join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {/* Lets search show large photo previews (image results, Discover) instead of thumbnails */}
    <meta name="robots" content="max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/feed.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {/* AVIF only: an untyped fallback preload would also be fetched by AVIF-capable browsers,
        downloading the LCP image twice. Browsers without AVIF simply skip the preload. */}
    {preloadSrcset && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        fetchpriority="high"
        imagesrcset={preloadSrcset}
        imagesizes={preloadSizes}
      />
    )}
    {isHome && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': [
            { '@type': 'WebSite', name: siteConfig.title, url: Astro.site!.href, description: siteConfig.description },
            { '@type': 'Person', name: siteConfig.author, url: Astro.site!.href, sameAs: siteConfig.sameAs },
          ],
        })}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class:list={['page', pageClass]}>
      <header class="site">
        <TitleTag class="name"><a href="/">{siteConfig.title}</a></TitleTag>
        {sheetLabel && <span class="zone-label" aria-hidden="true">Contact sheet</span>}
        <nav aria-label="Site">
          <a href="/index/" aria-current={current === 'index' ? 'page' : undefined}>Index</a>
          <a data-email={encodedEmail}>Email</a>
        </nav>
      </header>
      {/* Each template supplies <main id="main"> (and the photo page its footer) */}
      <slot />
    </div>
    <script is:inline define:vars={{ emailKey }}>
      for (const a of document.querySelectorAll('a[data-email]')) {
        a.href = 'mailto:' + a.dataset.email.replace(/../g, (h) => String.fromCharCode(parseInt(h, 16) ^ emailKey));
      }
    </script>
  </body>
</html>
