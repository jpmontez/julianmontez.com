---
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../config';
import { imageSrcsets } from '../utils';

interface Props {
  image: ImageMetadata;
  alt: string;
  isEager?: boolean;
  isLcp?: boolean;
  linkHref?: string;
}

const { image, alt, isEager = false, isLcp = false, linkHref } = Astro.props;

const { avif, webp, native, fallback } = await imageSrcsets(image);
const DISPLAY_WIDTH = 520; // matches max CSS display size (.post figure max-width)
const displayHeight = Math.round(DISPLAY_WIDTH * (image.height / image.width));
const Wrapper = linkHref ? 'a' : 'div';
---

<figure style={`aspect-ratio: ${DISPLAY_WIDTH} / ${displayHeight};`}>
  <Wrapper class={linkHref && 'post-image-link'} href={linkHref}>
    <picture>
      <source type="image/avif" srcset={avif} sizes={siteConfig.imageSizes} />
      <source type="image/webp" srcset={webp} sizes={siteConfig.imageSizes} />
      <img
        src={fallback}
        alt={alt}
        srcset={native}
        sizes={siteConfig.imageSizes}
        width={DISPLAY_WIDTH}
        height={displayHeight}
        loading={isEager ? 'eager' : 'lazy'}
        fetchpriority={isLcp ? 'high' : undefined}
        decoding="async"
      />
    </picture>
  </Wrapper>
</figure>
