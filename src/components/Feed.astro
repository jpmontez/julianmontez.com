---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostImage from './PostImage.astro';
import { siteConfig } from '../config';
import { displayDate, imageSrcsets, postSlug } from '../utils';

interface Props {
  posts: CollectionEntry<'posts'>[];
  pageNum: number;
  totalPages: number;
}

const { posts, pageNum, totalPages } = Astro.props;

const rendered = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content }))
);

// Preload the first post's first image (LCP candidate)
const { avif: preloadSrcset } = await imageSrcsets(posts[0].data.images[0].src);
const pageTitle = pageNum === 1 ? siteConfig.homeTitle : `Page ${pageNum} — ${siteConfig.title}`;
---

<BaseLayout pageTitle={pageTitle} preloadSrcset={preloadSrcset}>
  {rendered.map(({ post, Content }, index) => {
    const postUrl = `/${postSlug(post)}/`;

    return (
      <article class="post">
        <div class="image-stack">
          {post.data.images.map((img, i) => (
            <PostImage
              image={img.src}
              alt={img.alt}
              linkHref={postUrl}
              isEager={index === 0 && i === 0}
              isLcp={index === 0 && i === 0}
            />
          ))}
        </div>

        {post.body?.trim() && (
          <div class="body">
            <Content />
          </div>
        )}

        <div class="meta">
          {post.data.location && <span class="location">{post.data.location}</span>}
          <a href={postUrl}>
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{displayDate(post.data.date)}</time>
          </a>
        </div>
      </article>
    );
  })}

  {totalPages > 1 && (
    <nav class="feed-nav">
      {pageNum > 1 && <a href={pageNum === 2 ? '/' : `/page/${pageNum - 1}/`}>Newer</a>}
      {pageNum > 1 && pageNum < totalPages && <span> &bull; </span>}
      {pageNum < totalPages && <a href={`/page/${pageNum + 1}/`}>Older</a>}
      <div class="meta">Page {pageNum} of {totalPages}</div>
    </nav>
  )}
</BaseLayout>
