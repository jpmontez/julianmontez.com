---
import type { ImageMetadata } from 'astro';
import PostImage from './PostImage.astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;
---

<section class="slideshow" aria-label="Post image slideshow" data-slideshow>
  <div class="slideshow-viewport">
    <div class="slideshow-track">
      {images.map((image, i) => (
        <div class:list={['slide', { 'is-active': i === 0 }]} data-slide>
          <PostImage image={image.src} alt={image.alt} isEager={i < 2} isLcp={i === 0} />
        </div>
      ))}
    </div>
  </div>
  <div class="slideshow-nav" aria-label="Slideshow navigation">
    <button class="slideshow-control prev" type="button" aria-label="Previous photo">&#8249;</button>
    <span class="slideshow-counter" aria-live="polite">1 / {images.length}</span>
    <button class="slideshow-control next" type="button" aria-label="Next photo">&#8250;</button>
  </div>
</section>

<script is:inline>
(function () {
  // Rendered only on post pages with 2+ images, so there is exactly one slideshow.
  var slideshow = document.querySelector("[data-slideshow]");
  var viewport = slideshow.querySelector(".slideshow-viewport");
  var track = slideshow.querySelector(".slideshow-track");
  var counter = slideshow.querySelector(".slideshow-counter");
  var slides = slideshow.querySelectorAll("[data-slide]");
  var index = 0;
  var centerSlide = function () {
    var slide = slides[index];
    var translate = viewport.clientWidth / 2 - (slide.offsetLeft + slide.offsetWidth / 2);
    track.style.transform = "translateX(" + translate + "px)";
  };
  var snapCenter = function () {
    track.style.transition = "none";
    centerSlide();
    track.offsetHeight; /* force reflow */
    track.style.transition = "";
  };
  var setActive = function (nextIndex) {
    slides[index].classList.remove("is-active");
    index = (nextIndex + slides.length) % slides.length;
    slides[index].classList.add("is-active");
    counter.textContent = (index + 1) + " / " + slides.length;
    centerSlide();
  };
  slideshow.querySelector(".prev").addEventListener("click", function () {
    setActive(index - 1);
  });
  slideshow.querySelector(".next").addEventListener("click", function () {
    setActive(index + 1);
  });
  slides.forEach(function (slide, slideIndex) {
    slide.addEventListener("click", function () {
      setActive(slideIndex);
    });
    var img = slide.querySelector("img");
    if (!img.complete) {
      img.addEventListener("load", snapCenter);
    }
  });
  window.addEventListener("resize", snapCenter);
  var touchStartX = 0;
  var touchStartY = 0;
  slideshow.addEventListener("touchstart", function (e) {
    touchStartX = e.changedTouches[0].clientX;
    touchStartY = e.changedTouches[0].clientY;
  }, { passive: true });
  slideshow.addEventListener("touchend", function (e) {
    var dx = e.changedTouches[0].clientX - touchStartX;
    var dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) >= 50 && Math.abs(dy) <= Math.abs(dx)) {
      setActive(index + (dx < 0 ? 1 : -1));
    }
  });
  window.addEventListener("keydown", function (event) {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) {
      return;
    }
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") {
      return;
    }
    event.preventDefault();
    setActive(index + (event.key === "ArrowRight" ? 1 : -1));
  });
  snapCenter();
})();
</script>
